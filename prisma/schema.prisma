generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ChatSession {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  tokens      Int      @default(30)
  lastReset   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
